# =============================================================================
# Vitali Health AI — environment template
# Copy to .env and fill in. NEVER commit a real .env (it's gitignored).
# Every value here is read server-side only; nothing reaches the browser.
# =============================================================================

# ---- Which LLM backend powers the AI features --------------------------------
# One of: anthropic | ollama | anythingllm | auto
#   auto  -> use the first provider that is configured (anthropic, then
#            anythingllm, then ollama). Great for "just works" local dev.
LLM_PROVIDER=auto

# ---- Anthropic (Claude) — hosted, highest quality ---------------------------
# Get a key at https://console.anthropic.com . Leave blank to disable.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL=claude-opus-4-8

# ---- Ollama — fully local, private, free (great with Docker) -----------------
# Run `ollama serve` or use the bundled docker-compose. Then:
#   ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- AnythingLLM — local RAG workspace over your own clinical docs ------------
# Spin it up via docker-compose, create a workspace, generate an API key in
# Settings -> API Keys, then set the workspace slug below.
ANYTHINGLLM_BASE_URL=http://localhost:3001
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_WORKSPACE=vitali
